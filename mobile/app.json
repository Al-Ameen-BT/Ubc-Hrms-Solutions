{
  "expo": {
    "name": "UCB Employee",
    "slug": "ucb-employee",
    "version": "0.2.0",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "in.banihal.ucbemployee.uat",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#17324d",
        "foregroundImage": "./assets/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/splash-icon.png"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow UCB Employee to scan the QR code shown in your self-service portal.", "recordAudioAndroid": false, "barcodeScannerEnabled": true }],
      ["expo-splash-screen", { "backgroundColor": "#f7f9fc", "image": "./assets/splash-icon.png", "imageWidth": 180, "resizeMode": "contain" }],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
