# Copy to .env and fill in real values.
# Works with Hostinger's MySQL databases (deploy phase 1) and any Linux MySQL server (phase 2 - own server).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ucb_hrms
DB_USER=ucb_hrms_user
DB_PASSWORD=changeme
DB_DIALECT=mysql

# Use "sqlite" + DB_STORAGE=./dev.sqlite for zero-setup local testing/demo before MySQL is provisioned.
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite

NODE_ENV=development
PORT=3000

# --- Auth (required) ---------------------------------------------------
# Any long random string. Used to sign/verify JWT login tokens — changing
# it invalidates every issued token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRY=12h

# --- One-time setup endpoints (remove after use, then redeploy) --------
# Shared token that unlocks /admin/setup/init-db and
# /admin/setup/bootstrap-super-admin. Set it, use the endpoint(s) you need,
# then delete this var and redeploy so the endpoints disable themselves.
SETUP_TOKEN=changeme-random-one-time-token
# Only needed for the one bootstrap-super-admin call:
SUPER_ADMIN_EMAIL=admin@banihal.in
SUPER_ADMIN_PASSWORD=changeme-temp-password
SUPER_ADMIN_NAME=Banihal Super Admin

# --- Optional -----------------------------------------------------------
# Public address used in emailed links (password reset, welcome emails).
# Can also be set in Super Admin → Settings → General. If neither is set,
# the address the request arrived on is used.
# APP_BASE_URL=https://hrms.banihal.in
# Failed sign-ins allowed per IP per 15 minutes (default 20). Successful
# sign-ins don't count, so a branch office behind one IP isn't locked out.
# LOGIN_MAX_FAILURES=20
# Add missing tables/columns automatically at startup (default on). Set to
# false where schema changes must be applied by hand.
# AUTO_MIGRATE=true
