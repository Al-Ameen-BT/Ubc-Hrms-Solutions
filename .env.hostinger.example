# Hostinger TEST environment values. Copy to .env on the server (via SSH or
# hPanel's File Manager) — never commit this with real values.
#
# Hostinger MySQL databases and users are namespaced with your hosting
# account prefix, e.g. u123456789_ucbhrms / u123456789_ucbuser — copy the
# exact names shown in hPanel -> Databases -> MySQL Databases.

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_ucbhrms
DB_USER=u123456789_ucbuser
DB_PASSWORD=paste-the-password-hostinger-generated-here

NODE_ENV=production

# Hostinger's Node.js App (Passenger) sets PORT itself — the app already
# reads process.env.PORT in src/server.js, so you normally do NOT need to
# set this. Leave it unset unless hPanel's Node.js App screen tells you
# otherwise.
# PORT=3000

# --- Auth (required) ---------------------------------------------------
# Generate a real random value before going live — don't reuse this example.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRY=12h

# --- One-time setup (set only while running a setup call, then remove) -
SETUP_TOKEN=changeme-random-one-time-token
# Only needed once, for the bootstrap-super-admin call:
SUPER_ADMIN_EMAIL=admin@banihal.in
SUPER_ADMIN_PASSWORD=changeme-temp-password
SUPER_ADMIN_NAME=Banihal Super Admin

# --- Optional -----------------------------------------------------------
# Public address used in emailed links (password reset, welcome emails).
# Can also be set in Super Admin → Settings → General. If neither is set,
# the address the request arrived on is used.
# APP_BASE_URL=https://hrms.banihal.in
# Failed sign-ins allowed per IP per 15 minutes (default 20). Successful
# sign-ins don't count, so a branch office behind one IP isn't locked out.
# LOGIN_MAX_FAILURES=20
# Add missing tables/columns automatically at startup (default on). Set to
# false where schema changes must be applied by hand.
# AUTO_MIGRATE=true
